# ═══════════════════════════════════════════════════════════════
# AEGIX — Agentic Event Graph Intelligence System
# Environment Configuration Template
# ═══════════════════════════════════════════════════════════════

# ── Ollama (Offline LLM) ──
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT=30

# ── Online LLM (Mistral AI / OpenRouter / Cerebras) ──
ONLINE_LLM_PROVIDER=mistral
ONLINE_LLM_API_KEY=your_api_key_here
ONLINE_LLM_MODEL=mistral-small-latest
ONLINE_LLM_BASE_URL=https://api.mistral.ai/v1

# ── Vector Memory (ChromaDB) ──
CHROMA_PERSIST_DIR=./data/memory

# ── Audit ──
AUDIT_LOG_DIR=./data/audit

# ── Reports ──
REPORTS_DIR=./data/reports

# ── Security ──
AGENT_SECRET_KEY=aegix_default_secret_override_in_production
DEMO_MODE=true

# ── Network Monitor ──
HEARTBEAT_INTERVAL=30
HEARTBEAT_TIMEOUT=5
